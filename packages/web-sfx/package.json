{
  "name": "web-sfx",
  "version": "0.1.0",
  "description": "Alias of `sonics` — tiny, dependency-free UI sounds synthesised in the browser. Re-exports everything from `sonics`.",
  "author": "Philip Poloczek",
  "license": "MIT",
  "sideEffects": false,
  "main": "index.cjs",
  "module": "index.mjs",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.cjs"
    },
    "./react": {
      "types": "./react/index.d.ts",
      "import": "./react/index.mjs",
      "require": "./react/index.cjs"
    }
  },
  "files": ["index.mjs", "index.cjs", "index.d.ts", "react"],
  "publishConfig": {
    "access": "public"
  },
  "keywords": ["web-audio", "sound", "ui", "microinteraction", "click", "sfx", "sonics"],
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "sonics": "workspace:*"
  }
}
