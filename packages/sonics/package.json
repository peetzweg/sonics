{
  "name": "sonics",
  "version": "0.1.0",
  "description": "Tiny, dependency-free UI sounds you can feel. Synthesised in the browser with the Web Audio API — no audio files.",
  "author": "Philip Poloczek",
  "license": "MIT",
  "type": "commonjs",
  "sideEffects": false,
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react/index.d.mts",
        "default": "./dist/react/index.mjs"
      },
      "require": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:pkg": "publint --strict && attw --pack . --profile node16"
  },
  "keywords": [
    "web-audio",
    "sound",
    "ui",
    "microinteraction",
    "click",
    "sound-effects",
    "synthesis",
    "haptics",
    "react",
    "zero-dependency"
  ],
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.0",
    "@types/react": "^18.3.0",
    "publint": "^0.3.0",
    "react": "^18.3.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peetzweg/sonics.git",
    "directory": "packages/sonics"
  },
  "homepage": "https://peetzweg.github.io/sonics/",
  "bugs": "https://github.com/peetzweg/sonics/issues"
}
